# Never ignore asset meta data
!/[Aa]ssets/**/*.meta

# NuGetForUnity: packages are restored from Assets/packages.config on Unity start
/[Aa]ssets/[Pp]ackages/
/[Aa]ssets/[Pp]ackages.meta

