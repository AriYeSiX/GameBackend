@host = http://localhost:5165

### Check Healthy
GET {{host}}/health

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "tester",
  "email": "test@example.com",
  "password": "Password123"
}

> {%
    client.global.set("access", response.body.accessToken);
    client.global.set("refresh", response.body.refreshToken);
%}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123"
}

> {%
    client.global.set("access", response.body.accessToken);
    client.global.set("refresh", response.body.refreshToken);
%}

### Who is
GET {{host}}/api/players/me
Authorization: Bearer {{access}}

### Token Update
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refresh}}"
}

> {%
    client.global.set("access", response.body.accessToken);
    client.global.set("refresh", response.body.refreshToken);
%}

### Logout
POST {{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh}}"
}

### Update profile
PUT {{host}}/api/players/me
Authorization: Bearer {{access}}
Content-Type: application/json

{
  "username": "tester_renamed",
  "avatarUrl": "https://example.com/avatar.png"
}

### Save slot 1
PUT {{host}}/api/saves/1
Authorization: Bearer {{access}}
Content-Type: application/json

{
  "data": { "level": 5, "gold": 120, "inventory": ["sword", "potion"] },
  "expectedVersion": 0
}

### Get slot 1
GET {{host}}/api/saves/1
Authorization: Bearer {{access}}

### List slots
GET {{host}}/api/saves
Authorization: Bearer {{access}}